// Fullscreen Quad Vertex Shader for SD Modes (480p / 576p) on PS3 RSX (vp40 profile)
// Transforms Normalized Device Coordinates (NDC) directly into RSX raster clip space.
// Interleaves primary texture coordinates (TEXCOORD0) and dynamic SD texel spacing (TEXCOORD1).

struct vIn {
    float2 pos : POSITION;
    float2 uv  : TEXCOORD0;
    float2 ts  : TEXCOORD1;
};

struct vOut {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
    float2 ts  : TEXCOORD1;
};

vOut main(vIn IN) {
    vOut OUT;
    OUT.pos = float4(IN.pos.x, IN.pos.y, 0.0, 1.0);
    OUT.uv = IN.uv;
    OUT.ts = IN.ts;
    return OUT;
}
